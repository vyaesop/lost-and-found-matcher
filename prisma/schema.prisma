generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// SQLite has no enums, so type and timePeriod are validated strings.
model Report {
  id          String   @id @default(cuid())
  type        String
  title       String
  category    String
  description String   @default("")
  color       String
  location    String
  date        DateTime
  timePeriod  String   @default("unknown")
  createdAt   DateTime @default(now())
}
